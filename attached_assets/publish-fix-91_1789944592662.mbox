diff --git a/docs/JUDGE-PAPER-AUDIT.md b/docs/JUDGE-PAPER-AUDIT.md
index 55bca41..a5556e2 100644
--- a/docs/JUDGE-PAPER-AUDIT.md
+++ b/docs/JUDGE-PAPER-AUDIT.md
@@ -253,7 +253,11 @@ nothing (heavy selling +0.06% at 15 minutes, strong buying +0.07%). A line someb
   gate per cycle. Every transition is one log line with its numbers. The kill file (`data/learning/kill.json`, KILLED /
   invalid / unreadable) → reference lines; the reader re-reads it on the Judge's own reads (at most every 5 s), so a KILL
   or RESUME takes effect on the next look, not at the next scheduled refresh (review c6985361 F2). A lesson whose
-  `computedTs` is older than 7 days (the study stopped) is not a lesson: reference lines, one STALE line saying so (F3).
+  `computedTs` is older than 7 days (the study stopped) is not a lesson: reference lines, one STALE line saying so (F3); a
+  future-dated lesson (beyond 5 min of skew) is rejected and the clock is judged on every read (PUBLISH-FIX-89).
+  PUBLISH-FIX-91 (2026-09-20): a look is USABLE for a flow gate's study when every gate outside the flow family passed — item
+  20's "every other gate" counted the other four flow gates, which fail together on most looks, and left the learner 9-34
+  usable looks a day per gate against 1,000. The family is judged as a family; a structural refusal still excludes the look.
 - `learning/maturation.js` / `learning/service.js` / `fly.js` (PUBLISH-FIX-86, 2026-09-20; not frozen): the simulated 60-minute
   round trip (entry at the next bar's open, exit at the 60-minute close, the paper policy's taker fee both sides + 10 bps
   slippage against us) now runs for every LIVE episode — the service passes the paper cost model, matureEpisode simulates
diff --git a/learning/gate-lesson.js b/learning/gate-lesson.js
index 25fcac2..a4a3cd8 100644
--- a/learning/gate-lesson.js
+++ b/learning/gate-lesson.js
@@ -95,7 +95,11 @@ export function testsOf(episodes, outcomes, { yardstick = GATE_LESSON_DEFAULTS.y
     const real = e.gates.filter((g) => g && typeof g.id === 'string' && !NOT_A_GATE.has(g.id));
     for (const g of real) {
       if (!GATE_BANDS[g.id]) continue; const value = num(g.observed); const line = num(g.threshold); if (value === null || line === null) continue;
-      const othersOk = real.every((x) => x === g || x.ok === true);
+      // PUBLISH-FIX-91 (2026-09-20): a look is USABLE for a flow gate when every gate OUTSIDE the flow family passed. Item 20 demanded
+      // every other gate including the other four flow gates, and the flow gates fail together (4-5 at once on most looks): 9-34
+      // usable looks a day per gate against the 1,000 needed — the learner the owner built was starved by that one clause. The
+      // family moves together, so the family is judged together; a structural refusal (range, trend, book, stop) still excludes the look.
+      const othersOk = real.every((x) => x === g || x.ok === true || GATE_BANDS[x.id] !== undefined);
       out.push({ gate: g.id, setup: String(e.setupType ?? ''), ts: e.decisionTs, coin: e.canonicalCoin, value, line, othersOk, r });
     }
   }
diff --git a/test/learning-gate-lesson.test.js b/test/learning-gate-lesson.test.js
index 253cb15..9fa96c6 100644
--- a/test/learning-gate-lesson.test.js
+++ b/test/learning-gate-lesson.test.js
@@ -35,8 +35,8 @@ test('GL-01. testsOf joins looks with their scored 15-minute outcome by (coin, d
   assert.equal(tests.length, 5, JSON.stringify(tests));
   assert.ok(tests.some((t) => t.value === 0.7 && t.r === 0.9), 'a 1.5 s clock gap still joins'); assert.equal(tests.filter((t) => t.value === 0.7).length, 1, 'a 5 s gap does not');
   const ake = tests.filter((t) => t.gate === 'FI15' && t.value === 0.196); assert.equal(ake.length, 1); assert.equal(ake[0].othersOk, true, 'MOVE_CLOCK ok:false is not a gate'); assert.equal(ake[0].r, 1.2); assert.equal(ake[0].line, 0.2);
-  const akeRv = tests.find((t) => t.gate === 'RV60' && t.value === 2.5); assert.equal(akeRv.othersOk, false, 'FI15 failed beside it');
-  const zamaFi = tests.find((t) => t.gate === 'FI15' && t.value === 0.6); assert.equal(zamaFi.othersOk, false, 'RV60 failed beside it');
+  const akeRv = tests.find((t) => t.gate === 'RV60' && t.value === 2.5); assert.equal(akeRv.othersOk, true, 'PUBLISH-FIX-91: FI15 failing beside it is the flow family, not a structural refusal');
+  const zamaFi = tests.find((t) => t.gate === 'FI15' && t.value === 0.6); assert.equal(zamaFi.othersOk, true, 'PUBLISH-FIX-91: RV60 failing beside it is the flow family');
   assert.ok(!tests.some((t) => t.r === 5), 'the old look is outside the lookback');
 });
 
