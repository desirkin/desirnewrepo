run = "npm run paper"
entrypoint = "bin/cobra.js"
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["npm", "run", "paper"]
deploymentTarget = "vm"

[userenv]

# [userenv.shared] removed: provider keys must live in Replit Secrets (host private config), never in this tracked file.
# Optional sources only (CoinGecko demo, FRED). Set them as Secrets if wanted; absent, those senses report their
# own blocked/config-required state and core paper readiness is unaffected.
