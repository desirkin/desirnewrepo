+
+function parseLine(buffer, length, key, tracker, rows, entities, maxEntities, rowNumber) {
+  let text;
+  try { text = UTF8.decode(buffer.subarray(0, length)); }
+  catch { throw new Refusal('JSON_UTF8_INVALID', key); }
