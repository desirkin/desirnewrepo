+    // segment 2: the remaining path bars (1, 0). Bar 3 is deliberately absent so no second window forms.
+    const seg1Rows = [[8, 7, 6, 5, 4].map((i) => mkCandle({ i })), [mkCandle({ i: 2 })]].flat();
