+
+function readJsonl(file, expected, descriptor, tracker, sourceHash) {
+  const fileHash = createHash('sha256');
+  const rows = [];
+  const entities = new Set();
+  const chunk = Buffer.allocUnsafe(READ_CHUNK_BYTES);
