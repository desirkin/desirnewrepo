+  let stat;
+  try { stat = lstatSync(input, { bigint: true }); }
+  catch (error) {
+    if (error?.code === 'ENOENT') throw new Refusal(label === 'dataDir' ? 'DATA_DIR_NOT_FOUND' : 'STORE_NOT_COMMISSIONED');
