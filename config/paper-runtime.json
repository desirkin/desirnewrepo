   "THEBLOCK_NEWS": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY" },
   "COINTELEGRAPH_NEWS": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY" },
   "DECRYPT_NEWS": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY" },
   "FT_NEWS": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY", "reason": "BLOCKED_TERMS", "note": "public headline RSS composed; ft.com answered HTTP 403 to the runtime client from the development environment on 2026-09-12 (curl: 200) and the owner's terms review of ft.com syndication is unresolved, so the profile leaves it OFF" },
   "CNBC_NEWS": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY", "reason": "BLOCKED_TERMS", "note": "documented Top News RSS composed and read live through press/collector.js on 2026-09-12 (HTTP 200, 30 items); OFF until the owner accepts CNBC's RSS terms" },
   "GOOGLE_NEWS_AGGREGATOR": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "enableEnv": "PRESS_ENABLED", "coverage": "HEADLINE_LINK_ONLY", "reason": "BLOCKED_TERMS", "note": "aggregator RSS implemented (per-item publisher kept); no documented consumer API / terms for the RSS route, so OFF until the owner accepts" },
   "CNN_NEWS": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "reason": "BLOCKED_EXTERNAL_APPROVAL", "note": "CNN Newsource licensed interface not supplied; legacy CNN RSS endpoints returned HTTP 502 on 2026-09-12. No key is needed for the other public RSS adapters; no CNN route is invented." },
   "REUTERS_NEWS": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "reason": "BLOCKED_EXTERNAL_APPROVAL", "note": "LICENSED_INTERFACE_REQUIRED: no public feed; only the owner's licensed distribution agreement (Reuters Connect) can supply the interface — the code never invents one" },
   "BLOOMBERG_NEWS": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "module": "press/collector.js", "authority": "NONE", "reason": "BLOCKED_EXTERNAL_APPROVAL", "note": "LICENSED_INTERFACE_REQUIRED: Terminal / B-PIPE / Enterprise licensing only; never a scraped route" }
  }
 }
}
