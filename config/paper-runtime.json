    "DERIBIT": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
    "BYBIT": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "reason": "BLOCKED_GEOGRAPHY" },
    "GECKOTERMINAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
    "DEFILLAMA": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
