    "SETTLED_RECORDS": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
    "FRED": { "desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "credentialEnv": "FRED_API_KEY" },
    "COINGECKO": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "credentialEnv": "COINGECKO_DEMO_API_KEY", "reason": "DEMO_INCLUDED_QUOTA_TWO_CALL_VERIFICATION" },
    "COINGLASS": { "desiredState": "OFF", "blockerPolicy": "PAID_GATE", "credentialEnv": "COINGLASS_API_KEY", "reason": "BLOCKED_BUDGET" },
    "CRYPTOQUANT": { "desiredState": "OFF", "blockerPolicy": "PAID_GATE", "credentialEnv": "CRYPTOQUANT_API_KEY", "reason": "BLOCKED_BUDGET" },
    "SANTIMENT": { "desiredState": "OFF", "blockerPolicy": "PAID_GATE", "credentialEnv": "SANTIMENT_API_KEY", "reason": "BLOCKED_BUDGET" },
    "TWELVEDATA": { "desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "credentialEnv": "TWELVEDATA_API_KEY", "note": "Owner Basic 8 key verified with EUR/USD candles; free REST only, capped in research policy. Key must be installed in host Secrets; production collection remains unverified." },
    "TOKENOMIST": { "desiredState": "OFF", "blockerPolicy": "PAID_GATE", "credentialEnv": "TOKENOMIST_API_KEY", "reason": "BLOCKED_BUDGET" }
   }
  },
  "darkEdgeCapture": {
   "krakenCharts": { "desiredState": "ON", "blockerPolicy": "DARK_RESEARCH", "authority": "NONE", "consumers": "EDGE_CAPTURE only (never Socrates / Judge / Watch / execution)" },
   "krakenL3": { "desiredState": "REQUEST", "blockerPolicy": "DARK_RESEARCH", "authority": "NONE", "gate": "SAFE_L3_DATA_KEY", "blockedVerdict": "BLOCKED_NO_SAFE_L3_DATA_KEY", "credentialEnv": ["KRAKEN_L3_DATA_API_KEY", "KRAKEN_L3_DATA_API_SECRET"], "consumers": "EDGE_CAPTURE only (never Socrates / Judge / Watch / execution)" }
  },
  "socrates": {
   "caseRuntime": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "socrates/runtime.js", "authority": "NONE", "note": "runs inside the market-research service; a case without an authorized model seals BUDGET_BLOCKED (fail-closed, never a fabricated score)" },
   "model": { "desiredState": "REQUEST", "blockerPolicy": "PAID_GATE", "authority": "NONE", "credentialEnv": "ANTHROPIC_API_KEY", "budgetSource": "config/market-research.paper.json model.* (explicit USD caps; shipped 0 = blocked)" }
  },
  "judge": {
   "judge": { "desiredState": "ON", "blockerPolicy": "BLOCK_PAPER", "module": "judge/composition.js", "mode": "PAPER", "enableEnv": "JUDGE_ENABLED", "policyFile": "config/judge.paper.json", "accountId": "paper-reference-usd500", "authority": "PAPER_SIMULATION_ONLY" }
  },
  "watch": {
   "watch": { "desiredState": "ON", "blockerPolicy": "BLOCK_PAPER", "module": "watch/watch.js", "composedBy": "judge/composition.js", "authority": "PAPER_EXIT_INTENT_ONLY" }
  },
  "persistence": {
   "database": { "desiredState": "ON", "blockerPolicy": "BLOCK_PAPER", "module": "persistence/runtime.js", "env": "DATABASE_URL", "note": "PostgreSQL is the journal authority for PAPER accounts and the RUMOR2 event root; without it the Judge cannot start and permission-increasing behaviour stays locked" },
   "localJournalFallback": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "reason": "DISABLED_BY_PAPER_POLICY", "env": "RUMOR2_ALLOW_LOCAL_JOURNAL", "note": "never a silent fallback in the paper profile" }
  },
  "cockpit": {
