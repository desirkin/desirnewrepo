{
 "profileVersion": "serpent-paper-profile-1",
 "profileName": "paper",
 "runtimeMode": "PAPER",
 "authority": {
  "realMoney": "DISABLED",
  "liveOrders": "DISABLED",
  "withdrawFunding": "DISABLED",
  "judgeMode": "PAPER",
  "judgeAllowPrivate": false,
  "judgeAllowOrders": false,
  "darkSensesDecisionAuthority": "NONE",
  "law": "a credential present in the environment is never an enable; every paid or private activity needs this profile's separate enable + the subsystem's own budget / access gate; the Judge mode of this profile is PAPER and can never be LIVE"
 },
 "files": {
  "config": "cobra.config.json",
  "marketResearchPolicy": "config/market-research.paper.json",
  "marketResearchSubjects": "config/market-subjects.paper.json",
  "judgePolicy": "config/judge.paper.json",
  "envExample": ".env.paper.example",
  "runbook": "docs/PAPER-RUNBOOK.md"
 },
 "configOverlay": {
  "governance": { "enabled": true, "snapshotEnabled": false },
  "wideeye": { "enabled": true },
  "rumint": { "enabled": true },
  "universeExpansion": { "enabled": true },
  "gateway": { "enabled": true, "sources": { "kraken": true, "krakenSystem": true, "coinbase": true, "okx": true } }
 },
 "groups": {
  "coreObservation": {
   "tape": { "desiredState": "ON", "blockerPolicy": "BLOCK_PAPER", "module": "tape/run.js", "authority": "NONE", "note": "Kraken public WebSocket v2 market data; the only feed the Judge accepts" },
   "wideEye": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "survey/wideeye.js", "authority": "NONE" },
   "universeExpansion": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "tape/universe.js", "authority": "NONE" },
   "costExecutability": { "desiredState": "ON", "blockerPolicy": "BLOCK_PAPER", "module": "cost/model.js", "authority": "NONE" },
   "memoryMirror": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "memory/mirror.js", "authority": "NONE" },
   "socialStrainer": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "rumor2/social-research-strainer.js", "authority": "NONE" }
  },
  "infrastructure": {
   "gateway": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "gateway/collector.js", "authority": "NONE", "sources": ["kraken", "krakenSystem", "coinbase", "okx"], "note": "public status pages / system-status endpoints, polite polling; never trading permission" },
   "NOAA_SWPC": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "infra/collector.js", "authority": "NONE", "enableEnv": "INFRA_OBS_ENABLED", "experimental": true, "note": "NOAA SWPC planetary K-index + current R/S/G scales (public JSON, 10 min cadence); EXPERIMENTAL observation family, never a decision input" },
   "RIPE_RIS": { "desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "module": "infra/collector.js", "authority": "NONE", "enableEnv": "INFRA_OBS_ENABLED", "gate": "INFRA_RIPE_RESOURCES", "note": "RIPEstat routing-status for the operator's OWN monitored prefixes / ASNs (INFRA_RIPE_RESOURCES); CONFIG_REQUIRED until named — the profile never invents a watch list" },
   "CLOUDFLARE_RADAR": { "desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "module": "infra/collector.js", "authority": "NONE", "enableEnv": "INFRA_OBS_ENABLED", "credentialEnv": "CLOUDFLARE_API_TOKEN", "note": "Cloudflare Radar BGP announcement time series (the provider requires API-token authorization); CREDENTIAL_REQUIRED until the token is present" }
  },
  "rumorOfficial": {
   "rumor2": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "rumor2/collector.js", "authority": "NONE", "enableEnv": "RUMOR2_ENABLED" },
   "KRAKEN_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE" },
   "SEC_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE", "requiresEnv": ["SERPENT_HTTP_CONTACT"], "configRequired": "SERPENT_HTTP_CONTACT" },
   "CFTC_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE" },
   "EDGAR_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE", "enableEnv": "RUMOR2_EDGAR_ENABLED", "requiresEnv": ["SERPENT_HTTP_CONTACT", "RUMOR2_EDGAR_CIKS"], "configRequired": "EDGAR_WHITELIST", "note": "a CIK whitelist is operator configuration; the profile never invents one from test fixtures" },
   "OFAC_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE", "enableEnv": "RUMOR2_OFAC_ENABLED" },
   "rumintLegacy": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "rumint/poller.js", "authority": "NONE", "note": "StockTwits aggregate legacy ear; nominate / warn only" }
  },
  "social": {
   "BLUESKY_OFFICIAL": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "authority": "NONE", "enableEnv": "RUMOR2_SOCIAL_BLUESKY_ENABLED" },
   "X_OFFICIAL": { "desiredState": "REQUEST", "blockerPolicy": "PAID_GATE", "authority": "NONE", "paid": true, "enableEnv": "RUMOR2_SOCIAL_X_ENABLED", "credentialEnv": "X_BEARER_TOKEN", "budgetEnv": ["RUMOR2_SOCIAL_X_MAX_DAILY_POST_READS", "RUMOR2_SOCIAL_X_MAX_MONTHLY_POST_READS", "RUMOR2_SOCIAL_X_MAX_ESTIMATED_DAILY_USD"], "note": "activates only through the existing X governor: credential -> explicit budgets -> explicit paid smoke; this profile invents no budget" },
    "YOUTUBE_OFFICIAL": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "authority": "NONE", "reason": "DISABLED_BY_PAPER_POLICY", "enableEnv": "RUMOR2_SOCIAL_YOUTUBE_ENABLED", "credentialEnv": "YOUTUBE_API_KEY", "budgetEnv": ["RUMOR2_SOCIAL_YOUTUBE_MAX_DAILY_QUOTA_UNITS", "RUMOR2_SOCIAL_YOUTUBE_MAX_MONTHLY_QUOTA_UNITS"], "note": "read-only search.list fixture/request boundary; explicit quota-unit caps and existing bounded Social scope required; no collector or receipt" },
   "FARCASTER_OFFICIAL": {"desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "authority": "NONE", "note": "Collector code present; requires its own approved scope, credentials and explicit request allowance. No approval or allowance is supplied by this profile.", "credentialEnv": "NEYNAR_API_KEY"},
   "REDDIT_OFFICIAL": {"desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "authority": "NONE", "note": "Collector code present; requires its own approved scope, credentials and explicit request allowance. No approval or allowance is supplied by this profile.", "credentialEnv": "REDDIT_CLIENT_ID"},
   "STOCKTWITS_OFFICIAL": {"desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "authority": "NONE", "note": "Collector code present; requires its own approved scope, credentials and explicit request allowance. No approval or allowance is supplied by this profile.", "credentialEnv": "STOCKTWITS_STREAM_USER"},
   "META_PUBLIC": {"desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "authority": "NONE", "note": "Collector code present; requires its own approved scope, credentials and explicit request allowance. No approval or allowance is supplied by this profile.", "credentialEnv": "META_APP_TOKEN"},
   "TIKTOK_PUBLIC": { "desiredState": "OFF", "blockerPolicy": "DEGRADE", "authority": "NONE", "reason": "BLOCKED_TERMS" },
   "YOUTUBE_DATA_API": { "desiredState": "REQUEST", "blockerPolicy": "DEGRADE", "authority": "NONE", "module": "video/collector.js", "enableEnv": "SOCIAL_VIDEO_ENABLED", "credentialEnv": "YOUTUBE_API_KEY", "configEnv": ["SOCIAL_VIDEO_YOUTUBE_QUERIES", "SOCIAL_VIDEO_YOUTUBE_MAX_DAILY_SEARCHES"], "coverage": "METADATA_ONLY", "note": "separate social-video observation tier (video/) outside the frozen RUMOR-2 social registry; metadata only (never captions / transcripts); activates only when the key, the owner's own query list and an explicit daily search budget are all present" }
  },
  "marketResearch": {
   "service": { "desiredState": "ON", "blockerPolicy": "DEGRADE", "module": "market-lab/service.js", "authority": "NONE", "enableEnv": "MARKET_RESEARCH_ENABLED" },
   "providers": {
    "KRAKEN_SPOT": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
    "COINBASE_SPOT": { "desiredState": "ON", "blockerPolicy": "DEGRADE" },
