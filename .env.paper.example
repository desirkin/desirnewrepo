# SERPENT / COBRA — PAPER runtime profile environment (NAMES + placeholders ONLY; never commit a value).
# Copy to a private .env that your process manager loads; `node bin/cobra.js paper preflight` reads the same names.
# The profile (config/paper-runtime.json) sets every ENABLE flag itself; a value here never turns a paid or private
# activity on by itself, and the Judge mode of the paper profile can never become LIVE.

# ---- core ---------------------------------------------------------------------------------------------------------------
COBRA_PROFILE=config/paper-runtime.json      # the ONE profile the runtime, the CLI and the cockpit read
COBRA_DATA_DIR=./data                        # writable data directory (deployment: a persistent mount)
PORT=3000                                    # cockpit port
SERPENT_CONTROL_PASSWORD=<set-a-long-random-password>   # cockpit KILL / CAGE / CLEAR controls (human only)
SERPENT_HTTP_CONTACT=<name@example.com>      # required by SEC / EDGAR user-agent law (RUMOR official ears)

# ---- persistence (PostgreSQL is the journal authority for PAPER) ----------------------------------------------------
DATABASE_URL=<postgres-connection-url>
# SERPENT_DURABLE_REQUIRED=1                 # published deployments: refuse permission-increasing behaviour without durability

# ---- RUMOR official ears (public; contact + explicit whitelist) ---------------------------------------------------------
# RUMOR2_EDGAR_CIKS=<comma-separated CIKs you actually track>   # EDGAR stays CONFIG_REQUIRED:EDGAR_WHITELIST until set
# RUMOR2_EDGAR_FORMS=8-K,10-Q,10-K                             # optional; documented defaults apply when unset

# ---- social (X is PAID: credential AND explicit budgets AND an explicit paid smoke; nothing here is a default) ----------
# X_BEARER_TOKEN=<x-api-bearer>                 # absent -> CREDENTIAL_MISSING (X NOT OPERATIONAL, paper continues)
# RUMOR2_SOCIAL_X_MAX_DAILY_POST_READS=<n>      # absent with a bearer -> BUDGET_NOT_CONFIGURED
# RUMOR2_SOCIAL_X_MAX_MONTHLY_POST_READS=<n>
# RUMOR2_SOCIAL_X_MAX_ESTIMATED_DAILY_USD=<usd>
# RUMOR2_SOCIAL_X_MAX_SESSION_POST_READS=<n>
# RUMOR2_SOCIAL_X_LIVE_SMOKE_TARGET_POST_READS=<n>   # explicit paid smoke envelope (READY_REQUIRES_EXPLICIT_PAID_SMOKE until run)
# RUMOR2_SOCIAL_X_LIVE_SMOKE_MAX_POST_READS=<n>
# RUMOR2_SOCIAL_X_LIVE_SMOKE_RUN_ID=<run-id>

# ---- market research (credential-gated providers; env presence is NOT plan / cost authorization) --------------------------
# FRED_API_KEY=<free documented key>            # FRED is REQUESTED: activates with the key, else BLOCKED_CREDENTIAL
# COINGECKO_DEMO_API_KEY=<key>                  # OFF in this profile until plan + budget are attested in the policy
# COINGLASS_API_KEY=<key>
# CRYPTOQUANT_API_KEY=<key>
# SANTIMENT_API_KEY=<key>
# TWELVEDATA_API_KEY=<key>
# TOKENOMIST_API_KEY=<key>

# ---- Socrates model (interpretation only; explicit USD caps live in config/market-research.paper.json model.*) ------------
# ANTHROPIC_API_KEY=<key>                       # absent -> model BLOCKED_CREDENTIAL; cases seal BUDGET_BLOCKED (fail-closed)

# ---- Ask Serpent (cockpit conversation; recorded-evidence answers are always free and never call a model) ----------------
# Free-form AI chat is OFF until ALL THREE exist; the owner chooses the amounts, the code never does. Each send is one paid
# request, refused BEFORE dispatch when the estimate breaks either cap; the daily spend ledger survives restarts.
# ANTHROPIC_API_KEY=<key>                       # the same credential name as Socrates; chat budgets are separate from research budgets
# SERPENT_CHAT_MAX_USD_PER_REQUEST=<usd>        # e.g. 0.10 — required
# SERPENT_CHAT_MAX_USD_PER_DAY=<usd>            # e.g. 1.00 — required
# SERPENT_CHAT_MODEL=<known id>                 # optional; the known ids, their list prices and the default live in config/companion-chat.json

# ---- dark research: Kraken L3 (DATA-ONLY dedicated key; never an execution credential; never reused) ---------------------
# KRAKEN_L3_DATA_API_KEY=<dedicated data-only key WITH create-ws-token and NO trade/withdraw/funding permission>
# KRAKEN_L3_DATA_API_SECRET=<its secret>       # absent / unusable -> BLOCKED_NO_SAFE_L3_DATA_KEY (dark-research blocker only)

# ---- social video (video/: YouTube public METADATA only; separate tier, never a RUMOR-2 social event) ----------------------
# YOUTUBE_API_KEY=<google-api-key with the YouTube Data API v3 enabled>   # absent -> CREDENTIAL_MISSING (zero requests); sent only as a request header
# SOCIAL_VIDEO_YOUTUBE_QUERIES=<comma-separated search queries YOU choose, e.g. bitcoin,ethereum>   # absent -> CONFIG_REQUIRED (nothing invented)
# SOCIAL_VIDEO_YOUTUBE_MAX_DAILY_SEARCHES=<n>   # explicit daily search.list budget (documented default quota: 100 / day); absent -> BUDGET_NOT_CONFIGURED

# ---- infrastructure observation tier (infra/: dark, authority NONE; the profile selects the sources) -----------------------
# INFRA_RIPE_RESOURCES=<comma-separated prefixes / ASNs YOU operate or monitor, e.g. AS64496,192.0.2.0/24>   # RIPE RIS stays CONFIG_REQUIRED until set (never invented)
# CLOUDFLARE_API_TOKEN=<cloudflare-api-token>   # Radar read scope; absent -> CREDENTIAL_REQUIRED (zero calls); sent only as a header
# INFRA_CLOUDFLARE_ASN=<asn[,asn]>              # explicit Radar scope; INFRA_CLOUDFLARE_PREFIX=<prefix>; INFRA_CLOUDFLARE_DATE_RANGE=1d

# ---- Judge owner intent (init-paper needs it once; verified against SERPENT_CONTROL_PASSWORD) ---------------------------
# JUDGE_OWNER_PASSWORD=<the control password, supplied only for the init-paper command>

# NEVER set in the paper profile (the launcher forces them false): JUDGE_ALLOW_PRIVATE, JUDGE_ALLOW_ORDERS, JUDGE_MODE=LIVE_*.
# NEVER present here: any Kraken trading key. Real money, live orders, withdrawals and funding are DISABLED.

# ---- supported social transports (all REQUESTED; no calls until their gates pass) -----------------------------------------
# NEYNAR_API_KEY=<existing authorized free-plan key>
# RUMOR2_SOCIAL_FARCASTER_QUERIES=<JSON array of 1..8 approved searches>
# RUMOR2_SOCIAL_FARCASTER_MAX_DAILY_REQUESTS=<explicit integer 1..10000>
# RUMOR2_SOCIAL_FARCASTER_INTERVAL_SEC=<60..86400; default 300>
# REDDIT_CLIENT_ID=<approved Reddit application id>
# REDDIT_CLIENT_SECRET=<approved Reddit application secret>
# RUMOR2_SOCIAL_REDDIT_SUBREDDITS=<1..8 comma-separated approved subreddit names>
# RUMOR2_SOCIAL_REDDIT_USER_AGENT=<nodejs:app-id:version (by /u/owner)>
# RUMOR2_SOCIAL_REDDIT_MAX_DAILY_REQUESTS=<explicit integer 1..10000; token requests count too>
# STOCKTWITS_STREAM_USER=<licensed Firestream user>
# STOCKTWITS_STREAM_PASS=<licensed Firestream password>
# RUMOR2_SOCIAL_STOCKTWITS_SYMBOLS=<1..50 comma-separated provider symbols>
# RUMOR2_SOCIAL_STOCKTWITS_MAX_DAILY_REQUESTS=<explicit integer 1..10000>
# RUMOR2_SOCIAL_STOCKTWITS_ACCESS_COST=<INCLUDED only after verifying existing plan coverage>
# META_APP_TOKEN=<reviewed Meta API credential for the selected public-content routes>
# META_GRAPH_API_VERSION=<version explicitly supported by this Meta app, e.g. v23.0>
# META_INSTAGRAM_USER_ID=<Instagram professional-account id authorized for hashtag discovery>
# RUMOR2_SOCIAL_FACEBOOK_PAGE_IDS=<1..8 public page ids within the approved scope>
# RUMOR2_SOCIAL_INSTAGRAM_HASHTAG_IDS=<1..8 previously resolved hashtag ids in the approved account scope>
# RUMOR2_SOCIAL_INSTAGRAM_HASHTAG_SCOPE_REVIEW=<APPROVED_ACCOUNT_7_DAY_CAP after checking the account-wide rolling cap>
# RUMOR2_SOCIAL_META_MAX_DAILY_REQUESTS=<explicit shared Facebook + Instagram integer 1..10000>
# Approval-record field names, exact routes, retention and operating instructions: docs/sensor-runtime-configuration.md.
# No template below grants provider approval or substitutes for an actual entitlement.

# ---- Tally: profile enables governance collection, with Snapshot off; missing mapping/key means zero Tally requests --------
# TALLY_API_KEY=<authorized Tally API key>
# Verified governor mappings are configured in profile.configOverlay.governance.verifiedMappings; see the documentation.
# Requests use the existing hourly governance allowance and spacing; no paid plan is enrolled or increased.
# Radar scope must be explicit: ASN, valid prefix, or INFRA_CLOUDFLARE_GLOBAL=true if worldwide measurement is intended.
